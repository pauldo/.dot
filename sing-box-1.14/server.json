{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "local",
        "tag": "dns-local"
      }
    ],
    "final": "dns-local"
  },
  "inbounds": [
    {
      "type": "vless",
      "tag": "vless-reality-in",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        {
          "name": "user1",
          "uuid": "__VLESS_UUID__",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__REALITY_SNI__",
        "reality": {
          "enabled": true,
          "handshake": {
            "server": "__REALITY_SNI__",
            "server_port": 443
          },
          "private_key": "__REALITY_PRIVATE_KEY__",
          "short_id": [
            "__REALITY_SHORT_ID__"
          ]
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-tls-in",
      "listen": "0.0.0.0",
      "listen_port": 8444,
      "users": [
        {
          "name": "user1",
          "uuid": "__VLESS_TLS_UUID__",
          "flow": "xtls-rprx-vision"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "/etc/sing-box/cert/fullchain.pem",
        "key_path": "/etc/sing-box/cert/privkey.pem",
        "min_version": "1.3"
      }
    },
    {
      "type": "vmess",
      "tag": "vmess-ws-tls-in",
      "listen": "0.0.0.0",
      "listen_port": 8443,
      "users": [
        {
          "name": "user1",
          "uuid": "__VMESS_UUID__",
          "alterId": 0
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "/etc/sing-box/cert/fullchain.pem",
        "key_path": "/etc/sing-box/cert/privkey.pem",
        "alpn": [
          "http/1.1"
        ]
      },
      "transport": {
        "type": "ws",
        "path": "/__VMESS_WS_PATH__"
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-tls-in",
      "listen": "0.0.0.0",
      "listen_port": 9443,
      "users": [
        {
          "name": "user1",
          "password": "__TROJAN_PASSWORD__"
        }
      ],
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "/etc/sing-box/cert/fullchain.pem",
        "key_path": "/etc/sing-box/cert/privkey.pem"
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2-in",
      "listen": "0.0.0.0",
      "listen_port": 443,
      "users": [
        {
          "name": "user1",
          "password": "__HY2_PASSWORD__"
        }
      ],
      "obfs": {
        "type": "salamander",
        "password": "__HY2_OBFS_PASSWORD__"
      },
      "bbr_profile": "standard",
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "/etc/sing-box/cert/fullchain.pem",
        "key_path": "/etc/sing-box/cert/privkey.pem",
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "hysteria",
      "tag": "hy1-in",
      "listen": "0.0.0.0",
      "listen_port": 8443,
      "up_mbps": 100,
      "down_mbps": 100,
      "users": [
        {
          "name": "user1",
          "auth_str": "__HY1_PASSWORD__"
        }
      ],
      "obfs": "__HY1_OBFS_PASSWORD__",
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "certificate_path": "/etc/sing-box/cert/fullchain.pem",
        "key_path": "/etc/sing-box/cert/privkey.pem",
        "alpn": [
          "hysteria"
        ]
      }
    },
    {
      "type": "shadowsocks",
      "tag": "ss2022-in",
      "listen": "0.0.0.0",
      "listen_port": 8388,
      "method": "2022-blake3-aes-128-gcm",
      "password": "__SS_2022_KEY__"
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "final": "direct",
    "default_domain_resolver": "dns-local"
  }
}
