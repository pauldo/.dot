{
  "log": {
    "level": "info",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "udp",
        "tag": "dns-bootstrap",
        "server": "223.5.5.5",
        "server_port": 53
      },
      {
        "type": "https",
        "tag": "dns-remote",
        "server": "1.1.1.1",
        "server_port": 443,
        "path": "/dns-query",
        "tls": {
          "enabled": true,
          "server_name": "cloudflare-dns.com"
        },
        "detour": "proxy"
      }
    ],
    "final": "dns-remote"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "mixed-in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "proxy",
      "outbounds": [
        "auto",
        "vless-reality",
        "vless-tls",
        "vmess-ws-tls",
        "trojan-tls",
        "hy2",
        "hy1",
        "ss2022"
      ],
      "default": "vless-reality",
      "interrupt_exist_connections": true
    },
    {
      "type": "urltest",
      "tag": "auto",
      "outbounds": [
        "vless-reality",
        "vless-tls",
        "vmess-ws-tls",
        "trojan-tls",
        "hy2",
        "hy1",
        "ss2022"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50
    },
    {
      "type": "vless",
      "tag": "vless-reality",
      "server": "__SERVER_ADDRESS__",
      "server_port": 443,
      "uuid": "__VLESS_UUID__",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "__REALITY_SNI__",
        "utls": {
          "enabled": true,
          "fingerprint": "chrome"
        },
        "reality": {
          "enabled": true,
          "public_key": "__REALITY_PUBLIC_KEY__",
          "short_id": "__REALITY_SHORT_ID__"
        }
      }
    },
    {
      "type": "vless",
      "tag": "vless-tls",
      "server": "__SERVER_ADDRESS__",
      "server_port": 8444,
      "uuid": "__VLESS_TLS_UUID__",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "insecure": false,
        "min_version": "1.3"
      }
    },
    {
      "type": "vmess",
      "tag": "vmess-ws-tls",
      "server": "__SERVER_ADDRESS__",
      "server_port": 8443,
      "uuid": "__VMESS_UUID__",
      "security": "auto",
      "alter_id": 0,
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "insecure": false,
        "alpn": [
          "http/1.1"
        ]
      },
      "transport": {
        "type": "ws",
        "path": "/__VMESS_WS_PATH__",
        "headers": {
          "Host": "__TLS_DOMAIN__"
        }
      }
    },
    {
      "type": "trojan",
      "tag": "trojan-tls",
      "server": "__SERVER_ADDRESS__",
      "server_port": 9443,
      "password": "__TROJAN_PASSWORD__",
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "insecure": false
      }
    },
    {
      "type": "hysteria2",
      "tag": "hy2",
      "server": "__SERVER_ADDRESS__",
      "server_port": 443,
      "password": "__HY2_PASSWORD__",
      "obfs": {
        "type": "salamander",
        "password": "__HY2_OBFS_PASSWORD__"
      },
      "bbr_profile": "standard",
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "insecure": false,
        "alpn": [
          "h3"
        ]
      }
    },
    {
      "type": "hysteria",
      "tag": "hy1",
      "server": "__SERVER_ADDRESS__",
      "server_port": 8443,
      "up_mbps": 100,
      "down_mbps": 100,
      "auth_str": "__HY1_PASSWORD__",
      "obfs": "__HY1_OBFS_PASSWORD__",
      "tls": {
        "enabled": true,
        "server_name": "__TLS_DOMAIN__",
        "insecure": false,
        "alpn": [
          "hysteria"
        ]
      }
    },
    {
      "type": "shadowsocks",
      "tag": "ss2022",
      "server": "__SERVER_ADDRESS__",
      "server_port": 8388,
      "method": "2022-blake3-aes-128-gcm",
      "password": "__SS_2022_KEY__"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "port": 53,
        "action": "hijack-dns"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      }
    ],
    "final": "proxy",
    "default_domain_resolver": "dns-bootstrap",
    "auto_detect_interface": true
  },
  "experimental": {
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "secret": "__CLASH_API_SECRET__"
    }
  }
}
